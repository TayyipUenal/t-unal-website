{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tayyipuenal",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "triggers": { "crons": ["0 6 * * *"] },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tayyipuenal-partner",
      "database_id": "e4648e7c-2532-4e68-94a4-19e72910aa09"
    }
  ]
}
